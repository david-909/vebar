APP_NAME=Vebar
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=sr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=sr_Latn_RS

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="sajt@vebar.rs"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Public site
SITE_EMAIL=nikola-antic@vebar.rs
INQUIRY_RECIPIENT=nikola-antic@vebar.rs
INQUIRY_LIMIT_PER_HOUR=5
# Browser key for the homepage speed check; restrict it to the site's domain (HTTP referrers) in Google Cloud.
PAGESPEED_API_KEY=

# Analytics (rendered only in production unless ANALYTICS_ENABLED=true).
# Set GTM_CONTAINER_ID to load Google Tag Manager (configure GA4 + Google Ads inside it);
# otherwise GA4_MEASUREMENT_ID loads gtag.js directly.
# ANALYTICS_ENABLED=true
# GTM_CONTAINER_ID=GTM-XXXXXXX
GA4_MEASUREMENT_ID=G-TVHK53NE0R
# Consent Mode v2 defaults: "granted" or "denied".
CONSENT_ANALYTICS_DEFAULT=granted
CONSENT_ADS_DEFAULT=denied
